// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      // Runs the local tsup directly so that F5 works without pnpm on PATH.
      "label": "build",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "tsup"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}

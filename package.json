{
  "name": "pararead",
  "displayName": "ParaRead: Bilingual PDF Paper Reader",
  "version": "0.4.2",
  "description": "Read PDF papers sentence by sentence: hover a sentence and its translation sits right beside it, at the same height. Translates between 11 languages, including English, Chinese, Japanese, Korean, French, German and Spanish. Layout-preserving translation panel, DeepSeek or any OpenAI-compatible API, annotations saved into the PDF.",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "paper",
    "translate",
    "translation",
    "bilingual",
    "chinese",
    "japanese",
    "korean",
    "arxiv",
    "deepseek",
    "reader",
    "pararead"
  ],
  "homepage": "https://github.com/Chuanyunux/pararead#readme",
  "bugs": {
    "url": "https://github.com/Chuanyunux/pararead/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Chuanyunux/pararead.git"
  },
  "license": "Apache-2.0",
  "author": "Chuanyunux",
  "publisher": "chuanyunux",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsup",
    "check": "pnpm run typecheck && pnpm run check:pdfjs && oxlint --deny-warnings . && oxfmt --check .",
    "check:pdfjs": "node tools/check_pdfjs.mjs",
    "fix": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "fixtures": "node tools/dump_text_content.mjs",
    "format": "oxfmt --write .",
    "harness": "node tools/harness.mjs",
    "lint": "oxlint --deny-warnings .",
    "package": "pnpm run check:pdfjs && tsup --minify",
    "segment": "tsup tools/segment_fixture.ts --format esm --platform node --out-dir .cache/tools --no-config --silent && node .cache/tools/segment_fixture.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview",
    "vscode:prepublish": "pnpm run package",
    "watch": "tsup --watch"
  },
  "contributes": {
    "configuration": {
      "title": "ParaRead",
      "type": "object",
      "properties": {
        "pararead.defaultZoomValue": {
          "type": "string",
          "default": "auto",
          "scope": "resource",
          "enum": [
            "auto",
            "page-actual",
            "page-fit",
            "page-width",
            "50",
            "75",
            "100",
            "125",
            "150",
            "200"
          ],
          "enumDescriptions": [
            "%config.defaultZoomValue.auto%",
            "%config.defaultZoomValue.actual%",
            "%config.defaultZoomValue.fit%",
            "%config.defaultZoomValue.width%",
            "50%",
            "75%",
            "100%",
            "125%",
            "150%",
            "200%"
          ],
          "description": "%config.defaultZoomValue%"
        },
        "pararead.sidebarViewOnLoad": {
          "type": "number",
          "default": 0,
          "scope": "resource",
          "enum": [
            -1,
            0,
            1,
            2,
            3,
            4
          ],
          "enumDescriptions": [
            "%config.sidebarViewOnLoad.restore%",
            "%config.sidebarViewOnLoad.none%",
            "%config.sidebarViewOnLoad.thumbnails%",
            "%config.sidebarViewOnLoad.outline%",
            "%config.sidebarViewOnLoad.attachments%",
            "%config.sidebarViewOnLoad.layers%"
          ],
          "description": "%config.sidebarViewOnLoad%"
        },
        "pararead.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "markdownDescription": "%config.baseUrl%"
        },
        "pararead.model": {
          "type": "string",
          "default": "deepseek-flash",
          "markdownDescription": "%config.model%"
        },
        "pararead.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "%config.temperature%"
        },
        "pararead.requestTimeout": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "%config.requestTimeout%"
        },
        "pararead.maxCharsPerRequest": {
          "type": "number",
          "default": 3000,
          "minimum": 200,
          "description": "%config.maxCharsPerRequest%"
        },
        "pararead.targetLanguage": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "zh-TW",
            "en",
            "ja",
            "ko",
            "fr",
            "de",
            "es",
            "pt",
            "ru",
            "it"
          ],
          "enumItemLabels": [
            "%config.targetLanguage.autoLabel%",
            "简体中文",
            "繁體中文",
            "English",
            "日本語",
            "한국어",
            "Français",
            "Deutsch",
            "Español",
            "Português",
            "Русский",
            "Italiano"
          ],
          "enumDescriptions": [
            "%config.targetLanguage.auto%",
            "%language.zh-CN%",
            "%language.zh-TW%",
            "%language.en%",
            "%language.ja%",
            "%language.ko%",
            "%language.fr%",
            "%language.de%",
            "%language.es%",
            "%language.pt%",
            "%language.ru%",
            "%language.it%"
          ],
          "markdownDescription": "%config.targetLanguage%"
        },
        "pararead.sourceLanguage": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "zh-TW",
            "en",
            "ja",
            "ko",
            "fr",
            "de",
            "es",
            "pt",
            "ru",
            "it"
          ],
          "enumItemLabels": [
            "%config.sourceLanguage.autoLabel%",
            "简体中文",
            "繁體中文",
            "English",
            "日本語",
            "한국어",
            "Français",
            "Deutsch",
            "Español",
            "Português",
            "Русский",
            "Italiano"
          ],
          "enumDescriptions": [
            "%config.sourceLanguage.auto%",
            "%language.zh-CN%",
            "%language.zh-TW%",
            "%language.en%",
            "%language.ja%",
            "%language.ko%",
            "%language.fr%",
            "%language.de%",
            "%language.es%",
            "%language.pt%",
            "%language.ru%",
            "%language.it%"
          ],
          "markdownDescription": "%config.sourceLanguage%"
        },
        "pararead.glossary": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "object"
            ]
          },
          "markdownDescription": "%config.glossary%"
        },
        "pararead.translateRange": {
          "type": "string",
          "default": "nearby",
          "enum": [
            "page",
            "nearby",
            "manual"
          ],
          "enumDescriptions": [
            "%config.translateRange.page%",
            "%config.translateRange.nearby%",
            "%config.translateRange.manual%"
          ],
          "description": "%config.translateRange%"
        },
        "pararead.cacheDir": {
          "type": "string",
          "default": "",
          "description": "%config.cacheDir%"
        },
        "pararead.extraBody": {
          "type": "object",
          "default": {
            "thinking": {
              "type": "disabled"
            }
          },
          "markdownDescription": "%config.extraBody%"
        },
        "pararead.selectOnHover": {
          "type": "boolean",
          "default": true,
          "description": "%config.selectOnHover%"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "pararead.view",
        "displayName": "%editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "pararead.setApiKey",
        "title": "%command.setApiKey%",
        "category": "ParaRead"
      },
      {
        "command": "pararead.chooseTargetLanguage",
        "title": "%command.chooseTargetLanguage%",
        "category": "ParaRead"
      },
      {
        "command": "pararead.translatePage",
        "title": "%command.translatePage%",
        "category": "ParaRead"
      },
      {
        "command": "pararead.translateDocument",
        "title": "%command.translateDocument%",
        "category": "ParaRead"
      },
      {
        "command": "pararead.clearCache",
        "title": "%command.clearCache%",
        "category": "ParaRead"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pararead.translatePage",
          "when": "activeCustomEditorId == pararead.view"
        },
        {
          "command": "pararead.translateDocument",
          "when": "activeCustomEditorId == pararead.view"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "26.6.1",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^4.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "vscode": "^1.95.0"
  },
  "icon": "icon.png",
  "preview": true,
  "l10n": "./l10n"
}
